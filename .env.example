# Configuración opcional de los formularios. En producción: Vercel > Settings > Environment Variables.
# En local: .env.local (ignorado por Git). Nunca commitear claves o destinos reales.
# El portfolio funciona sin estas claves; los endpoints de envío devuelven 503 hasta configurarlos.
RESEND_API_KEY=
# Cuenta y dominio remitente verificados en Resend.
CONTACT_FROM=
CONTACT_TO=
# Widget de Turnstile autorizado para migueos.vercel.app.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
# Clave aleatoria de al menos 32 caracteres para confirmar reseñas.
GUESTBOOK_SECRET=
SITE_URL=https://migueos.vercel.app
# Contadores compartidos entre funciones: 3/min en Correo, 5/min en reseñas y 1/min por destinatario/token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
