{
  "name": "mike-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio de Miguel Fombuena: un escritorio con Astro y Svelte, alojado en Vercel.",
  "author": "Miguel Fombuena",
  "license": "MIT",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/preparar-vercel.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=escritorio --project=movil",
    "test:e2e:navegadores": "playwright test --project=safari --project=safari-movil --project=firefox",
    "deploy": "pnpm dlx vercel --prod",
    "test:csp": "playwright test -c playwright.csp.config.ts"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@astrojs/vercel": "11.0.16",
    "astro": "7.3.8",
    "sharp": "^0.35.5",
    "simple-icons": "^16.34.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
